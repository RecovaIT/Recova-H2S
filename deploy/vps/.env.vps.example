# Recova-H2S Standalone VPS Configuration (h2s.recovahq.com)
# Copy to .env.vps next to docker-compose.vps.yml and populate secrets,
# or run bash deploy/vps/setup-vps.sh to generate secrets automatically.

ENVIRONMENT=production
APP_NAME="Recova Anticipatory Health Platform"

# Dedicated loopback ports (isolated from existing /var/www/recova/production stack)
H2S_FRONTEND_PORT=3810
H2S_BACKEND_PORT=8810

# Isolated PostgreSQL 16 database inside recova_h2s_net (not bound to host port 5432)
POSTGRES_USER=recova_h2s
POSTGRES_PASSWORD=__GENERATE_POSTGRES_PASSWORD__
POSTGRES_DB=recova_h2s

# Required Security Keys
# SECRET_KEY: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# FIELD_ENCRYPTION_KEY: python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SECRET_KEY=__GENERATE_SECRET_KEY__
FIELD_ENCRYPTION_KEY=__GENERATE_FIELD_ENCRYPTION_KEY__

# HTTPS Session & Origin Configuration (h2s.recovahq.com)
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
SESSION_TTL_MINUTES=480
SESSION_IDLE_TIMEOUT_MINUTES=60
CORS_ORIGINS=["https://h2s.recovahq.com"]
FRONTEND_BASE_URL=https://h2s.recovahq.com

# Optional LLM Provider (Agent 5 — Clinical Synthesis)
# Supported: none | openai | azure_openai | gemini | anthropic
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_AZURE_DEPLOYMENT=
LLM_AZURE_API_VERSION=2024-06-01

# Optional Email / SMS / WhatsApp Notification Providers
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# Optional UAE HIE Adapters
MALAFFI_BASE_URL=
MALAFFI_CLIENT_ID=
MALAFFI_CLIENT_SECRET=
MALAFFI_TOKEN_URL=
SAHATNA_BASE_URL=
SAHATNA_API_KEY=
