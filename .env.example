# Recova Anticipatory Health Platform — Environment Configuration
ENVIRONMENT=development
APP_NAME="Recova Anticipatory Health Platform"
API_PREFIX=/api/v1

# PostgreSQL (change credentials in production)
DATABASE_URL=postgresql+psycopg://recova:recova@localhost:5432/recova

# Security — MUST be set to unique random values in production
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Generate FIELD_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=dev-insecure-secret-change-me-0000000000000000
FIELD_ENCRYPTION_KEY=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_TTL_MINUTES=480
SESSION_IDLE_TIMEOUT_MINUTES=60
CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_BASE_URL=http://localhost:3000

# Background Worker
RUN_EMBEDDED_WORKER=true
WORKER_POLL_INTERVAL_SECONDS=1.0
SCHEDULER_INTERVAL_SECONDS=60

# LLM Provider Abstraction (Agent 5 — Clinical Synthesis)
# Supported: none | openai | azure_openai | gemini | anthropic
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_AZURE_DEPLOYMENT=
LLM_AZURE_API_VERSION=2024-06-01
LLM_TIMEOUT_SECONDS=45.0

# Notification Providers (leave empty if not configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# External HIE Integrations (leave empty until credentials are provisioned)
MALAFFI_BASE_URL=
MALAFFI_CLIENT_ID=
MALAFFI_CLIENT_SECRET=
MALAFFI_TOKEN_URL=
SAHATNA_BASE_URL=
SAHATNA_API_KEY=

# Frontend proxy & API base URL (Next.js rewrites /api/v1/* -> BACKEND_INTERNAL_URL)
NEXT_PUBLIC_API_BASE_URL=/api/v1
BACKEND_INTERNAL_URL=http://localhost:8000
